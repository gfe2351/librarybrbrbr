@model IEnumerable<NationalLibraryApp.Models.Book>
@{
    Layout = "_Layout";
}

<div class="container my-5">
    <!-- Шапка проекта -->
    <div class="p-5 mb-5 bg-dark text-white rounded-4 shadow-lg position-relative overflow-hidden">
        <div class="position-relative z-1">
            <h1 class="display-4 fw-bold mb-2">@ViewBag.LibraryName</h1>
            <p class="fs-5 text-light opacity-75">@ViewBag.Welcome</p>
        </div>
        <div class="position-absolute top-0 end-0 p-4 opacity-10 display-1">
            📚
        </div>
    </div>

    <!-- Уведомления -->
    @if (ViewBag.Message != null)
    {
        <div class="alert @(ViewBag.IsError ? "alert-danger" : "alert-success") alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi @(ViewBag.IsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i> @ViewBag.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Статистика библиотеки (Задача 23) -->
    <div class="row g-4 text-center mb-5">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 bg-primary text-white h-100">
                <div class="card-body p-4">
                    <h6 class="text-uppercase fw-semibold opacity-75">Всего книг</h6>
                    <p class="display-6 fw-bold mb-0">@ViewBag.Stats.Total</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 bg-success text-white h-100">
                <div class="card-body p-4">
                    <h6 class="text-uppercase fw-semibold opacity-75">Доступно</h6>
                    <p class="display-6 fw-bold mb-0">@ViewBag.Stats.Available</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 bg-warning text-dark h-100">
                <div class="card-body p-4">
                    <h6 class="text-uppercase fw-semibold opacity-75">Выдано</h6>
                    <p class="display-6 fw-bold mb-0">@ViewBag.Stats.Borrowed</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 bg-info text-white h-100">
                <div class="card-body p-4">
                    <h6 class="text-uppercase fw-semibold opacity-75">Читателей</h6>
                    <p class="display-6 fw-bold mb-0">@ViewBag.Stats.ReadersCount</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Панель управления (Формы действий) -->
    <div class="row g-4 mb-5">
        <!-- Добавить книгу -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-body">
                <h5 class="fw-bold text-primary mb-3">📖 Добавить книгу</h5>
                <form asp-action="AddBook" method="post">
                    <div class="form-floating mb-3">
                        <input type="text" name="title" class="form-control" id="bookTitle" placeholder="Название" required />
                        <label for="bookTitle">Название книги</label>
                    </div>
                    <div class="form-floating mb-3">
                        <input type="text" name="author" class="form-control" id="bookAuthor" placeholder="Автор" required />
                        <label for="bookAuthor">Автор</label>
                    </div>
                    <div class="form-floating mb-3">
                        <input type="number" name="year" class="form-control" id="bookYear" placeholder="Год" required />
                        <label for="bookYear">Год издания</label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold rounded-3">Добавить</button>
                </form>
            </div>
        </div>

        <!-- Личный кабинет -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-body d-flex flex-column justify-content-center text-center">
                <div class="mb-3 display-5">👤</div>
                <h5 class="fw-bold text-secondary mb-2">Личный кабинет</h5>
                <p class="text-muted small mb-3">Регистрация, просмотр и редактирование профиля читателя.</p>
                <a href="/Reader" class="btn btn-secondary w-100 py-2 fw-semibold rounded-3">Открыть кабинет</a>
            </div>
        </div>

        <!-- Выдать книгу -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-body">
                <h5 class="fw-bold text-warning mb-3">📤 Выдать книгу</h5>
                <form asp-action="BorrowBook" method="post">
                    <div class="form-floating mb-3">
                        <input type="text" name="title" class="form-control" id="borrowTitle" placeholder="Книга" required />
                        <label for="borrowTitle">Название книги</label>
                    </div>
                    <div class="form-floating mb-3">
                        <input type="text" name="readerName" class="form-control" id="borrowReader" placeholder="Читатель" required />
                        <label for="borrowReader">Имя читателя</label>
                    </div>
                    <button type="submit" class="btn btn-warning w-100 py-2 fw-semibold rounded-3 text-dark mt-4">Выдать книгу</button>
                </form>
            </div>
        </div>

        <!-- Вернуть книгу -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-body">
                <h5 class="fw-bold text-success mb-3">📥 Вернуть книгу</h5>
                <form asp-action="ReturnBook" method="post">
                    <div class="form-floating mb-3">
                        <input type="text" name="title" class="form-control" id="returnTitle" placeholder="Книга" required />
                        <label for="returnTitle">Название книги</label>
                    </div>
                    <div class="form-floating mb-3">
                        <input type="number" name="overdueDays" class="form-control" id="returnDays" placeholder="Дни" value="0" />
                        <label for="returnDays">Дней просрочки</label>
                    </div>
                    <button type="submit" class="btn btn-success w-100 py-2 fw-semibold rounded-3 text-white mt-4">Вернуть</button>
                </form>
            </div>
        </div>
    </div>

    <hr class="text-muted my-5" />

    <!-- Поиск и список книг -->
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h3 class="fw-bold mb-0">Каталог книг</h3>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <a asp-action="SortByYear" class="btn btn-outline-dark rounded-pill px-3 me-2">Сортировать по году</a>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">Сбросить</a>
        </div>
    </div>

    <!-- Строка поиска -->
    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group shadow-sm rounded-pill overflow-hidden border">
            <input type="text" name="searchTitle" class="form-control border-0 px-4 py-3" placeholder="Поиск книги по названию..." />
            <button class="btn btn-primary px-4" type="submit">Найти</button>
        </div>
    </form>

    <!-- Таблица -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th class="py-3 ps-4">Название</th>
                    <th class="py-3">Автор</th>
                    <th class="py-3">Год</th>
                    <th class="py-3">Возраст книги</th>
                    <th class="py-3 pe-4">Статус</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model)
                {
                    <tr>
                        <td class="ps-4 fw-semibold text-primary">@book.Title</td>
                        <td>@book.Author</td>
                        <td>@book.Year</td>
                        <td><span class="text-muted">@book.CalculateBookAge() лет</span></td>
                        <td class="pe-4">
                            @if (book.IsAvailable)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-semibold">Доступна</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill fw-semibold">Выдана</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>