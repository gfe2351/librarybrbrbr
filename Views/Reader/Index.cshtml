@{
    Layout = "_Layout";
    var readers = (List<NationalLibraryApp.Models.Reader>)ViewBag.Readers;
    var institutions = (List<string>)ViewBag.Institutions;
}

<div class="container my-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h1 class="fw-bold mb-0">👤 Личный кабинет читателя</h1>
        <a href="/" class="btn btn-outline-secondary rounded-pill px-3">← На главную</a>
    </div>

    <!-- Уведомления -->
    @if (TempData["Message"] != null)
    {
        <div class="alert @(Convert.ToBoolean(TempData["IsError"]) ? "alert-danger" : "alert-success") alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Форма регистрации -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-5 bg-body">
        <h5 class="fw-bold text-primary mb-4">📝 Регистрация нового читателя</h5>
        <form action="/Reader/Register" method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">ФИО</label>
                    <input type="text" name="FullName" class="form-control" placeholder="Иванов Иван Иванович" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Дата рождения</label>
                    <input type="date" name="DateOfBirth" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Пол</label>
                    <select name="Gender" class="form-select" required>
                        <option value="Male">Мужской</option>
                        <option value="Female">Женский</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Тип места</label>
                    <select name="InstitutionType" class="form-select" required>
                        <option value="Study">Учёба</option>
                        <option value="Work">Работа</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Место учёбы/работы</label>
                    <select name="Institution" id="institutionSelect" class="form-select" required>
                        <option value="">Выберите из списка...</option>
                        @foreach (var institution in institutions)
                        {
                            <option value="@institution">@institution</option>
                        }
                        <option value="custom">Другое (ввести своё)</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Своё место учёбы/работы</label>
                    <input type="text" name="customInstitution" id="customInstitution" class="form-control" placeholder="Введите название" disabled />
                </div>
                <div class="col-md-4">
                    <label class="form-label">ИИН</label>
                    <input type="text" name="IIN" class="form-control" maxlength="12" pattern="\d{12}" placeholder="12 цифр" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Почта</label>
                    <input type="email" name="Email" class="form-control" placeholder="mail@example.com" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Номер телефона</label>
                    <input type="tel" name="Phone" class="form-control" placeholder="+77001234567" required />
                </div>
            </div>
            <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold mt-4">Зарегистрировать читателя</button>
        </form>
    </div>

    <!-- Список читателей -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-dark text-white py-3 fw-bold">Список читателей</div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">#</th>
                        <th>ФИО</th>
                        <th>Дата рождения</th>
                        <th>Пол</th>
                        <th>Место учёбы/работы</th>
                        <th>ИИН</th>
                        <th>Почта</th>
                        <th>Телефон</th>
                        <th class="pe-4">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reader in readers)
                    {
                        <tr>
                            <td class="ps-4">@reader.Id</td>
                            <td class="fw-semibold">@reader.FullName</td>
                            <td>@reader.DateOfBirth.ToString("dd.MM.yyyy")</td>
                            <td>@(reader.Gender == Gender.Male ? "Мужской" : "Женский")</td>
                            <td>@reader.Institution <span class="text-muted">(@(reader.InstitutionType == InstitutionType.Study ? "учёба" : "работа"))</span></td>
                            <td>@reader.IIN</td>
                            <td>@reader.Email</td>
                            <td>@reader.Phone</td>
                            <td class="pe-4 text-nowrap">
                                <a href="/Reader/Profile/@reader.Id" class="btn btn-sm btn-outline-primary me-1">Профиль</a>
                                <a href="/Reader/Edit/@reader.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    const institutionSelect = document.getElementById('institutionSelect');
    const customInstitution = document.getElementById('customInstitution');

    institutionSelect.addEventListener('change', () => {
        const isCustom = institutionSelect.value === 'custom';
        customInstitution.disabled = !isCustom;
        customInstitution.required = isCustom;
        if (isCustom) {
            customInstitution.focus();
        } else {
            customInstitution.value = '';
        }
    });
</script>
