@model NationalLibraryApp.Models.Reader
@{
    Layout = "_Layout";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white py-4">
                    <h4 class="fw-bold mb-0">👤 Личный кабинет</h4>
                </div>
                <div class="card-body p-4 p-md-5">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <p class="text-muted small mb-1">ФИО</p>
                            <p class="fw-semibold fs-5">@Model.FullName</p>
                        </div>
                        <div class="col-md-6">
                            <p class="text-muted small mb-1">Дата рождения</p>
                            <p class="fw-semibold fs-5">@Model.DateOfBirth.ToString("dd.MM.yyyy")</p>
                        </div>
                        <div class="col-md-6">
                            <p class="text-muted small mb-1">Пол</p>
                            <p class="fw-semibold fs-5">@(Model.Gender == Gender.Male ? "Мужской" : "Женский")</p>
                        </div>
                        <div class="col-md-6">
                            <p class="text-muted small mb-1">Тип места</p>
                            <p class="fw-semibold fs-5">@(Model.InstitutionType == InstitutionType.Study ? "Учёба" : "Работа")</p>
                        </div>
                        <div class="col-md-6">
                            <p class="text-muted small mb-1">Место учёбы/работы</p>
                            <p class="fw-semibold fs-5">@Model.Institution</p>
                        </div>
                        <div class="col-md-6">
                            <p class="text-muted small mb-1">ИИН</p>
                            <p class="fw-semibold fs-5">@Model.IIN</p>
                        </div>
                        <div class="col-md-6">
                            <p class="text-muted small mb-1">Почта</p>
                            <p class="fw-semibold fs-5">@Model.Email</p>
                        </div>
                        <div class="col-md-6">
                            <p class="text-muted small mb-1">Номер телефона</p>
                            <p class="fw-semibold fs-5">@Model.Phone</p>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4 pt-3 border-top">
                        <a href="/Reader/Edit/@Model.Id" class="btn btn-primary px-4 py-2 fw-semibold">Редактировать</a>
                        <a href="/Reader" class="btn btn-outline-secondary px-4 py-2 fw-semibold">Назад к списку</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
